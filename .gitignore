# Python caches and test artifacts
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local Python runtime bundle
Python314/

# Virtual environments
.venv/
venv/
env/

# Local Codex/session settings
.codex/

# Local environment and secrets
.env
.env.*
!.env.example

# Generated Enterprise runtime files
workspace/jobs/
workspace/outputs/

# 临时:纳入 workspace/logs 便于排查问题(排查完可删本行及相关例外恢复忽略)
!workspace/logs/
!workspace/logs/**

# Keep the runtime workspace directory structure available for fresh clones
!workspace/
!workspace/.gitkeep

# SOLIDWORKS/CAD generated files and temporary locks
*.SLDPRT
*.SLDASM
*.SLDDRW
*.sldprt
*.sldasm
*.slddrw
*.STEP
*.STP
*.step
*.stp
*.IGES
*.IGS
*.iges
*.igs
*.x_t
*.x_b
*.sat
*.swp
~$*

# Logs, temp files, and OS/editor noise
*.log
*.tmp
*.bak
# 临时:上面的 *.log/*.tmp/*.bak 会再次忽略 logs 目录内的日志文件，这里重新放行(排查完可删)
!workspace/logs/**/*.log
!workspace/logs/**/*.tmp
!workspace/logs/**/*.bak
*.orig
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# PyInstaller / packaging build artifacts
build/
dist/
*.egg-info/

# Top-level generated outputs
outputs/

# .NET / Visual Studio build artifacts (SolidWorks addin & preview)
bin/
obj/
.vs/
*.dll
*.exe
*.pdb
*.user
*.suo

