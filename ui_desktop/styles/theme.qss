QMainWindow {
  background: #eef6ff;
  color: #17212f;
}

QWidget#WorkbenchPage {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
    stop:0 #f7fbff,
    stop:0.55 #eef7ff,
    stop:1 #e8fff9);
}

QFrame#LeftNav {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 #1768d2,
    stop:1 #0f766e);
  color: #ffffff;
}

QLabel#NavTitle {
  font-size: 18px;
  font-weight: 800;
  padding: 16px;
  color: #ffffff;
}

QListWidget {
  border: none;
  background: transparent;
  color: #e8f7ff;
  font-size: 14px;
  outline: none;
}

QListWidget::item {
  padding: 11px 14px;
  border-radius: 8px;
  margin: 3px 10px;
}

QListWidget::item:selected {
  background: rgba(255, 255, 255, 0.20);
  color: #ffffff;
}

QFrame#RightStatus {
  background: #f6fbff;
  border-left: 1px solid #cfe2f5;
}

QGroupBox {
  background: #ffffff;
  border: 1px solid #cfe2f5;
  border-radius: 10px;
  margin-top: 12px;
  padding: 10px;
  font-weight: 700;
  color: #17212f;
}

QGroupBox::title {
  subcontrol-origin: margin;
  left: 12px;
  padding: 0 6px;
  color: #1768d2;
}

QWidget#ConversationPanel,
QWidget#Composer {
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid #cfe2f5;
  border-radius: 16px;
}

QLabel#PanelTitle {
  color: #1268d4;
  font-size: 22px;
  font-weight: 800;
}

QLabel#PanelSubtitle {
  color: #496579;
  font-size: 13px;
}

QPlainTextEdit#ConversationLog {
  background: #f8fcff;
  border: 1px solid #d6e7f7;
  border-radius: 12px;
  padding: 14px;
  color: #1f2d3d;
  selection-background-color: #b7ddff;
}

QTextEdit#PromptEdit {
  background: #ffffff;
  border: 1px solid #b8d7f2;
  border-radius: 14px;
  padding: 10px;
  color: #17212f;
  font-size: 14px;
}

QTextEdit#PromptEdit:focus,
QLineEdit#ConfirmEdit:focus,
QComboBox#ModeCombo:focus {
  border: 1px solid #2f80ed;
}

QComboBox#ModeCombo {
  background: #f8fcff;
  border: 1px solid #b8d7f2;
  border-radius: 8px;
  padding: 5px 10px;
  color: #17212f;
  min-width: 105px;
}

QLineEdit#ConfirmEdit {
  background: #ffffff;
  border: 1px solid #b8d7f2;
  border-radius: 10px;
  padding: 8px 10px;
  color: #17212f;
}

QWidget#ConfirmPanel {
  background: #e8fff9;
  border: 1px solid #22c7b8;
  border-radius: 12px;
}

QLabel#ConfirmPrompt {
  color: #0f766e;
  font-weight: 700;
}

QPushButton {
  background: #eaf4ff;
  border: 1px solid #b8d7f2;
  border-radius: 9px;
  color: #1768d2;
  padding: 8px 14px;
  font-weight: 700;
}

QPushButton:hover {
  background: #dff0ff;
  border-color: #2f80ed;
}

QPushButton:disabled {
  background: #edf2f7;
  border-color: #d7e0ea;
  color: #93a4b5;
}

QPushButton#PrimaryButton {
  background: #2f80ed;
  border: 1px solid #1768d2;
  color: #ffffff;
  font-size: 14px;
  min-width: 72px;
}

QPushButton#PrimaryButton:hover {
  background: #1768d2;
}

QPushButton#ActionButton {
  background: #ffffff;
}

QTableWidget, QLineEdit, QComboBox, QTextEdit, QPlainTextEdit {
  selection-background-color: #b7ddff;
}

QLabel#StatusBadge {
  border-radius: 8px;
  padding: 6px 10px;
  font-weight: 800;
}

QLabel#StatusBadge[badgeLevel="neutral"] {
  background: #e5f1ff;
  color: #1768d2;
}

QLabel#StatusBadge[badgeLevel="success"] {
  background: #dffaf3;
  color: #0f766e;
}

QLabel#StatusBadge[badgeLevel="warning"] {
  background: #fff4d6;
  color: #9a6500;
}

QLabel#StatusBadge[badgeLevel="danger"] {
  background: #ffe2e5;
  color: #b4232c;
}
